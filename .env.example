# MongoDB connection string (Atlas or local instance)
MONGODB_URI=mongodb://localhost:27017/estate-portal

# JWT secret key for signing authentication tokens
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars

# JWT token expiration window (e.g., 1d, 7d)
JWT_EXPIRES_IN=1d

# Cloudinary cloud name for media storage
CLOUDINARY_CLOUD_NAME=demo-cloud

# Cloudinary API key
CLOUDINARY_API_KEY=123456789012345

# Cloudinary API secret
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz12

# Razorpay key id for payments (optional in mock mode)
RAZORPAY_KEY_ID=rzp_test_placeholder

# Razorpay key secret (optional in mock mode)
RAZORPAY_KEY_SECRET=rzp_secret_placeholder

# Secret key used to sign mock gateway payment callbacks
MOCK_GATEWAY_SECRET=mock-payment-gateway-secret-for-timing-safe-hmac

# Default platform fee percentage charged on property exit sale (0-20)
PLATFORM_FEE_PCT=2

# Default broker commission percentage paid when property is 100% funded (0-10)
BROKER_COMMISSION_PCT=1

# Maximum percentage of total units a single investor can purchase per property (1-100)
MAX_OWNERSHIP_PCT=49

# Public base URL of the frontend application
NEXT_PUBLIC_APP_URL=http://localhost:3000
